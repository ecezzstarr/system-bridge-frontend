# ===========================================
# SYSTEM BRIDGE - ENVIRONMENT VARIABLES
# For Google Cloud Run Deployment
# ===========================================

# Cloud SQL Configuration
CLOUD_SQL_CONNECTION_NAME=your-project-id:us-central1:system-bridge-db
CLOUD_SQL_DATABASE=ssbnow
CLOUD_SQL_USER=ssbnow_user
CLOUD_SQL_PASSWORD=your-database-password

# For local development with Cloud SQL Proxy
CLOUD_SQL_HOST=127.0.0.1
CLOUD_SQL_PORT=5432
CLOUD_SQL_SSL=false

# Flutterwave Payment Keys
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-at-least-64-characters-long

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-cloud-run-url.run.app

