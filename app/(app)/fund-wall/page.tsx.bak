'use client'

import { useEffect, useState } from 'react'
import useSWR from 'swr'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { DollarSign, TrendingUp, PieChart, RefreshCw, Users, Zap } from 'lucide-react'
import { formatTrx } from '@/lib/db'

interface FundWallData {
  platformStats: {
    totalBalance: number
    totalLockedInEscrow: number
    totalInTransit: number
    totalUsers: number
    totalTransactions: number
  }
  topWallets: Array<{
    userId: string
    username: string
    balance: number
    role: string
    department: string
  }>
  recentActivity: Array<{
    id: string
    type: string
    amount: number
    username: string
    timestamp: string
  }>
  walletTiers: {
    bronze: number
    silver: number
    gold: number
    platinum: number
    diamond: number
  }
}

export default function FundWallPage() {
  const { data, error, mutate, isLoading } = useSWR<FundWallData>(
    '/api/admin/fund-wall',
    async (url) => {
      const res = await fetch(url)
      if (!res.ok) throw new Error('Failed to fetch fund wall data')
      return res.json()
    },
    {
      revalidateOnFocus: true,
      revalidateOnReconnect: true,
      dedupingInterval: 10000,
      focusThrottleInterval: 60000,
    }
  )

  const handleRefresh = async () => {
    await mutate()
  }

  return (
    <div className="space-y-4 sm:space-y-6 p-3 sm:p-6">
      {/* Page Header */}
      <div className="flex items-center justify-between gap-2">
        <div>
          <h1 className="text-xl sm:text-3xl font-bold">Fund Wall</h1>
          <p className="text-xs sm:text-sm text-muted-foreground">Platform-wide financial overview</p>
        </div>
        <button
          onClick={handleRefresh}
          disabled={isLoading}
          className="p-2 hover:bg-primary/10 rounded-lg transition-colors"
        >
          <RefreshCw className={`h-5 w-5 ${isLoading ? 'animate-spin' : ''}`} />
        </button>
      </div>

      {/* Platform Stats Grid - Mobile Responsive */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {/* Total Balance */}
        <Card className="bg-gradient-to-br from-blue-500/10 to-blue-500/5">
          <CardHeader className="pb-2">
            <CardTitle className="text-xs sm:text-sm font-medium text-muted-foreground flex items-center gap-1">
              <DollarSign className="h-3 w-3 sm:h-4 sm:w-4" />
              Total Balance
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-xl sm:text-2xl font-bold">
              {data ? formatTrx(data.platformStats.totalBalance) : '0'}
            </p>
            <p className="text-xs text-muted-foreground mt-1">TRX</p>
          </CardContent>
        </Card>

        {/* Locked in Escrow */}
        <Card className="bg-gradient-to-br from-amber-500/10 to-amber-500/5">
          <CardHeader className="pb-2">
            <CardTitle className="text-xs sm:text-sm font-medium text-muted-foreground flex items-center gap-1">
              <Zap className="h-3 w-3 sm:h-4 sm:w-4" />
              In Escrow
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-xl sm:text-2xl font-bold">
              {data ? formatTrx(data.platformStats.totalLockedInEscrow) : '0'}
            </p>
            <p className="text-xs text-muted-foreground mt-1">Locked</p>
          </CardContent>
        </Card>

        {/* In Transit */}
        <Card className="bg-gradient-to-br from-purple-500/10 to-purple-500/5">
          <CardHeader className="pb-2">
            <CardTitle className="text-xs sm:text-sm font-medium text-muted-foreground flex items-center gap-1">
              <TrendingUp className="h-3 w-3 sm:h-4 sm:w-4" />
              In Transit
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-xl sm:text-2xl font-bold">
              {data ? formatTrx(data.platformStats.totalInTransit) : '0'}
            </p>
            <p className="text-xs text-muted-foreground mt-1">Pending</p>
          </CardContent>
        </Card>

        {/* Total Users */}
        <Card className="bg-gradient-to-br from-green-500/10 to-green-500/5">
          <CardHeader className="pb-2">
            <CardTitle className="text-xs sm:text-sm font-medium text-muted-foreground flex items-center gap-1">
              <Users className="h-3 w-3 sm:h-4 sm:w-4" />
              Active Users
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-xl sm:text-2xl font-bold">{data?.platformStats.totalUsers || '0'}</p>
            <p className="text-xs text-muted-foreground mt-1">Members</p>
          </CardContent>
        </Card>

        {/* Total Transactions */}
        <Card className="bg-gradient-to-br from-pink-500/10 to-pink-500/5">
          <CardHeader className="pb-2">
            <CardTitle className="text-xs sm:text-sm font-medium text-muted-foreground flex items-center gap-1">
              <PieChart className="h-3 w-3 sm:h-4 sm:w-4" />
              Transactions
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p className="text-xl sm:text-2xl font-bold">{data?.platformStats.totalTransactions || '0'}</p>
            <p className="text-xs text-muted-foreground mt-1">Total</p>
          </CardContent>
        </Card>
      </div>

      {/* Wallet Tier Distribution */}
      {data?.walletTiers && (
        <Card>
          <CardHeader className="pb-3">
            <CardTitle className="text-base sm:text-lg">Wallet Distribution</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="grid grid-cols-2 sm:grid-cols-5 gap-2 sm:gap-3">
              {Object.entries(data.walletTiers).map(([tier, count]) => (
                <div key={tier} className="p-2 sm:p-3 rounded-lg bg-muted/50 text-center">
                  <p className="text-xs sm:text-sm font-semibold capitalize">{tier}</p>
                  <p className="text-lg sm:text-2xl font-bold mt-1">{count}</p>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      {/* Top Wallets */}
      <Card>
        <CardHeader className="pb-3">
          <CardTitle className="text-base sm:text-lg">Top Wallets</CardTitle>
          <CardDescription className="text-xs sm:text-sm">Highest balance holders</CardDescription>
        </CardHeader>
        <CardContent>
          <div className="space-y-2">
            {data?.topWallets && data.topWallets.length > 0 ? (
              data.topWallets.slice(0, 10).map((wallet, idx) => (
                <div key={wallet.userId} className="flex items-center justify-between p-2 sm:p-3 rounded-lg bg-muted/50">
                  <div className="space-y-0.5 min-w-0">
                    <div className="flex items-center gap-2 flex-wrap">
                      <span className="text-xs sm:text-sm font-semibold">#{idx + 1}</span>
                      <p className="text-xs sm:text-sm font-medium truncate">{wallet.username}</p>
                      <Badge variant="outline" className="text-xs">
                        {wallet.role}
                      </Badge>
                    </div>
                    <p className="text-xs text-muted-foreground">{wallet.department}</p>
                  </div>
                  <p className="text-xs sm:text-sm font-bold text-right whitespace-nowrap ml-2">
                    {formatTrx(wallet.balance)} TRX
                  </p>
                </div>
              ))
            ) : (
              <p className="text-xs sm:text-sm text-muted-foreground text-center py-4">No wallets yet</p>
            )}
          </div>
        </CardContent>
      </Card>

      {/* Recent Activity */}
      <Card>
        <CardHeader className="pb-3">
          <CardTitle className="text-base sm:text-lg">Recent Activity</CardTitle>
          <CardDescription className="text-xs sm:text-sm">Platform transactions</CardDescription>
        </CardHeader>
        <CardContent>
          <div className="space-y-2">
            {data?.recentActivity && data.recentActivity.length > 0 ? (
              data.recentActivity.slice(0, 15).map((activity) => (
                <div key={activity.id} className="flex items-center justify-between p-2 sm:p-3 rounded-lg bg-muted/50">
                  <div className="space-y-0.5 min-w-0">
                    <p className="text-xs sm:text-sm font-medium capitalize">{activity.type}</p>
                    <p className="text-xs text-muted-foreground truncate">{activity.username}</p>
                  </div>
                  <div className="text-right whitespace-nowrap ml-2">
                    <p className="text-xs sm:text-sm font-semibold">{formatTrx(activity.amount)} TRX</p>
                    <p className="text-xs text-muted-foreground">
                      {new Date(activity.timestamp).toLocaleTimeString()}
                    </p>
                  </div>
                </div>
              ))
            ) : (
              <p className="text-xs sm:text-sm text-muted-foreground text-center py-4">No activity yet</p>
            )}
          </div>
        </CardContent>
      </Card>
    </div>
  )
}
