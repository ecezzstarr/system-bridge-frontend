'use client'

import { useState, useRef, useEffect } from 'react'
import { useParams, useRouter } from 'next/navigation'
import { Send, Loader2, Sparkles, Copy, Check, MessageCircle, X, ClipboardList, Scale, Search, UserCog } from 'lucide-react'
import dynamic from 'next/dynamic'

const SystemSwitchScene = dynamic(() => import('@/components/system-switch/SystemSwitchScene'), { ssr: false })

interface Message { role: 'user' | 'assistant'; content: string }

interface Bridger {
  id: string
  name: string
  username: string | null
}

const FILE_FOLDER_PRICE_TRX = 35800
const COMPANY_WALLET = 'THGBvmPt3XEb8mbSRXViA93GkW3PpCanJk'

const SUPPORT_POSITIONS = [
  { id: 'mandate', name: 'Mandate Officer', icon: ClipboardList },
  { id: 'lawyer', name: 'Legal Counsel', icon: Scale },
  { id: 'forensic', name: 'Forensic Expert', icon: Search },
  { id: 'admin', name: 'Administrator', icon: UserCog },
]

interface SupportMessage { id: string; senderType: 'visitor' | 'staff'; content: string; createdAt: string }

function getFingerprint(code: string) {
  if (typeof window === 'undefined') return 'server'
  const key = `bridge_fp_${code}`
  let fp = localStorage.getItem(key)
  if (!fp) {
    fp = crypto.randomUUID()
    localStorage.setItem(key, fp)
  }
  return fp
}

function getStoredSystemSwitchSession(code: string): string | null {
  if (typeof window === 'undefined') return null
  return localStorage.getItem(`bridge_ss_session_${code}`)
}

function storeSystemSwitchSession(code: string, sessionId: string) {
  if (typeof window === 'undefined') return
  localStorage.setItem(`bridge_ss_session_${code}`, sessionId)
}

export default function BridgePage() {
  const params = useParams()
  const router = useRouter()
  const code = params.code as string

  const [loading, setLoading] = useState(true)
  const [notFound, setNotFound] = useState(false)
  const [experienceType, setExperienceType] = useState<string>('chat_only')
  const [bridger, setBridger] = useState<Bridger | null>(null)
  const [messages, setMessages] = useState<Message[]>([])
  const [sessionId, setSessionId] = useState<string | null>(null)
  const [input, setInput] = useState('')
  const [sending, setSending] = useState(false)
  const [readyToJoin, setReadyToJoin] = useState(false)

  // System Switch entry gate. A visitor only sees Continue/Start once they
  // already hold a File Number (fileNumber below) — the File Folder/Number
  // purchase flow (showDeposit etc.) always runs first, unchanged.
  const [ssGate, setSsGate] = useState<'na' | 'choose' | 'entered'>('na')
  const [ssExistingState, setSsExistingState] = useState<any>(null)
  const messagesEndRef = useRef<HTMLDivElement>(null)

  // Deposit flow state
  const [understood, setUnderstood] = useState(false)
  const [showDeposit, setShowDeposit] = useState(false)
  const [selectedTier, setSelectedTier] = useState<number | null>(null)
  const [prospectName, setProspectName] = useState('')
  const [prospectPhone, setProspectPhone] = useState('')
  const [txHash, setTxHash] = useState('')
  const [depositId, setDepositId] = useState<string | null>(null)
  const [depositStatus, setDepositStatus] = useState<'idle' | 'pending' | 'approved' | 'rejected'>('idle')
  const [fileNumber, setFileNumber] = useState<string | null>(null)
  const [submittingDeposit, setSubmittingDeposit] = useState(false)
  const [copied, setCopied] = useState(false)

  // Support panel: talk to a real company position within this session.
  const [supportOpen, setSupportOpen] = useState(false)
  const [supportPosition, setSupportPosition] = useState<string | null>(null)
  const [supportMessages, setSupportMessages] = useState<SupportMessage[]>([])
  const [supportInput, setSupportInput] = useState('')
  const [supportSending, setSupportSending] = useState(false)
  const [supportLoading, setSupportLoading] = useState(false)

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  }, [messages, showDeposit, depositStatus])

  useEffect(() => {
    fetch(`/api/bridge/${code}`)
      .then(r => r.json())
      .then(data => {
        if (!data.success) {
          setNotFound(true)
        } else {
          setMessages([{ role: 'assistant', content: data.welcomeMessage }])
          setExperienceType(data.experienceType || 'chat_only')
          setBridger(data.bridger || null)
        }
      })
      .catch(() => setNotFound(true))
      .finally(() => setLoading(false))
  }, [code])

  // Poll for admin approval once a deposit is submitted
  useEffect(() => {
    if (!depositId || depositStatus !== 'pending') return
    const interval = setInterval(async () => {
      try {
        const res = await fetch(`/api/bridge/${code}/deposit/${depositId}`)
        const data = await res.json()
        if (data.success && data.status !== 'pending') {
          setDepositStatus(data.status)
          if (data.status === 'approved' && data.fileNumber) {
            setFileNumber(data.fileNumber)
            if (experienceType === 'system_switch') {
              const storedSessionId = getStoredSystemSwitchSession(code)
              if (storedSessionId) {
                fetch(`/api/system-switch/state?sessionId=${storedSessionId}`)
                  .then(r => r.json())
                  .then(stateData => {
                    if (stateData.success && stateData.state && stateData.state.status !== 'recognized') {
                      setSsExistingState(stateData.state)
                    }
                    setSsGate('choose')
                  })
                  .catch(() => setSsGate('choose'))
              } else {
                setSsGate('choose')
              }
            }
          }
        }
      } catch {}
    }, 5000)
    return () => clearInterval(interval)
  }, [depositId, depositStatus, code])

  const sendMessage = async () => {
    if (!input.trim() || sending) return
    const userMessage = input.trim()
    setInput('')
    const nextMessages = [...messages, { role: 'user' as const, content: userMessage }]
    setMessages(nextMessages)
    setSending(true)

    if (/continue|join|sign up|register|deposit/i.test(userMessage)) {
      setReadyToJoin(true)
    }

    try {
      const res = await fetch(`/api/bridge/${code}/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sessionId,
          visitorFingerprint: getFingerprint(code),
          messages: nextMessages,
        }),
      })
      const data = await res.json()
      if (data.success) {
        setMessages(prev => [...prev, { role: 'assistant', content: data.response }])
        if (!sessionId) setSessionId(data.sessionId)
        // Only Bridge's own explicit continuation phrase surfaces the button —
        // never a keyword match on either side of the conversation. The
        // visitor still has to read a plain-language explanation and
        // confirm before ever seeing tiers or a wallet address.
        if (/continue inside the weave/i.test(data.response)) setReadyToJoin(true)
      }
    } catch {
      setMessages(prev => [...prev, { role: 'assistant', content: 'Connection hiccup — try again?' }])
    }
    setSending(false)
  }

  const handleStartJoin = () => {
    fetch(`/api/bridge/${code}/track`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ eventType: 'continue_click', sessionId }),
    }).catch(() => {})
    setUnderstood(false)
  }

  const handleConfirmUnderstanding = () => {
    fetch(`/api/bridge/${code}/track`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ eventType: 'understanding_confirmed', sessionId }),
    }).catch(() => {})
    setUnderstood(true)
    setShowDeposit(true)
  }

  const handleCopyWallet = () => {
    navigator.clipboard.writeText(COMPANY_WALLET)
    setCopied(true)
    setTimeout(() => setCopied(false), 1500)
  }

  const handleSubmitDeposit = async () => {
    if (!selectedTier || !prospectName.trim() || !prospectPhone.trim()) return
    setSubmittingDeposit(true)
    try {
      const res = await fetch(`/api/bridge/${code}/deposit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          sessionId,
          name: prospectName.trim(),
          phone: prospectPhone.trim(),
          tierTrx: selectedTier,
          txHash: txHash.trim() || undefined,
        }),
      })
      const data = await res.json()
      if (data.success) {
        setDepositId(data.depositId)
        setDepositStatus('pending')
      }
    } catch {}
    setSubmittingDeposit(false)
  }

  const handleGoToRegister = () => {
    router.push(`/client/register?fileNumber=${encodeURIComponent(fileNumber || '')}`)
  }

  const handleSystemSwitchStartFresh = () => {
    localStorage.removeItem(`bridge_ss_session_${code}`)
    setSsExistingState(null)
    if (sessionId) {
      storeSystemSwitchSession(code, sessionId)
      fetch('/api/system-switch/state', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId, fileNumber }),
      }).catch(() => {})
    }
    setSsGate('entered')
  }

  const handleSystemSwitchContinue = () => {
    const storedSessionId = getStoredSystemSwitchSession(code)
    if (storedSessionId) setSessionId(storedSessionId)
    setSsGate('entered')
  }

  const fetchSupportMessages = async (position: string) => {
    if (!sessionId) return
    setSupportLoading(true)
    try {
      const res = await fetch(`/api/bridge/${code}/support?sessionId=${sessionId}&position=${position}`)
      const data = await res.json()
      if (data.success) setSupportMessages(data.messages)
    } catch {}
    setSupportLoading(false)
  }

  const handleOpenSupport = (positionId: string) => {
    setSupportPosition(positionId)
    setSupportOpen(true)
    fetchSupportMessages(positionId)
  }

  const handleSendSupportMessage = async () => {
    if (!supportInput.trim() || !supportPosition || !sessionId || supportSending) return
    const content = supportInput.trim()
    setSupportInput('')
    setSupportSending(true)
    try {
      const res = await fetch(`/api/bridge/${code}/support`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId, position: supportPosition, content }),
      })
      const data = await res.json()
      if (data.success) setSupportMessages(prev => [...prev, data.message])
    } catch {}
    setSupportSending(false)
  }

  useEffect(() => {
    if (!supportOpen || !supportPosition) return
    const interval = setInterval(() => fetchSupportMessages(supportPosition), 5000)
    return () => clearInterval(interval)
  }, [supportOpen, supportPosition])

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center" style={{ background: 'var(--background)' }}>
        <Loader2 className="h-8 w-8 animate-spin" style={{ color: 'var(--secondary)' }} />
      </div>
    )
  }

  if (notFound) {
    return (
      <div className="min-h-screen flex items-center justify-center px-4" style={{ background: 'var(--background)' }}>
        <p style={{ color: 'var(--muted-foreground)' }}>This link isn't active right now.</p>
      </div>
    )
  }

  // System Switch is locked until the File Folder/File Number has been issued.
  // The Bridge Template remains the entrance before that point.
  const showScene =
    experienceType === 'system_switch' &&
    !!fileNumber &&
    ssGate === 'entered'
  return (
    <div className="min-h-screen flex flex-col relative" style={{ background: showScene ? 'transparent' : 'var(--background)' }}>
      {showScene && (
        <div className="fixed inset-0 z-0">
          <SystemSwitchScene />
        </div>
      )}
      <div className="relative z-10 flex flex-col min-h-screen">
      <div className="flex items-center gap-3 px-4 py-4 border-b" style={{ borderColor: 'var(--field-border)' }}>
        <div
          className="w-9 h-9 rounded-full flex items-center justify-center"
          style={{ background: 'linear-gradient(135deg, var(--primary), var(--secondary))' }}
        >
          <Sparkles className="h-4 w-4 text-black" />
        </div>
        <span className="font-semibold flex-1" style={{ color: 'var(--foreground)' }}>WEAVE</span>
        {sessionId && (
          <button
            onClick={() => setSupportOpen(true)}
            className="flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full border"
            style={{ borderColor: 'var(--field-border)', color: 'var(--muted-foreground)' }}
          >
            <MessageCircle className="h-3.5 w-3.5" />
            Talk to a specialist
          </button>
        )}
      </div>

      {/* BRIDGER — the person carrying this Bridge */}
      {bridger && (
        <div className="max-w-2xl mx-auto w-full px-4 pt-6">
          <div
            className="rounded-2xl border p-5"
            style={{
              background: 'var(--card)',
              borderColor: 'var(--border)',
            }}
          >
            <div className="flex items-center gap-4">
              <div
                className="w-12 h-12 rounded-full flex items-center justify-center shrink-0"
                style={{
                  background:
                    'linear-gradient(135deg, var(--primary), var(--secondary))',
                }}
              >
                <UserCog className="h-5 w-5 text-black" />
              </div>

              <div className="min-w-0">
                <p
                  className="text-xs uppercase tracking-wider"
                  style={{ color: 'var(--muted-foreground)' }}
                >
                  Your Bridger
                </p>

                <p
                  className="font-semibold truncate"
                  style={{ color: 'var(--foreground)' }}
                >
                  {bridger.name}
                </p>

                {bridger.username && (
                  <p
                    className="text-xs"
                    style={{ color: 'var(--muted-foreground)' }}
                  >
                    @{bridger.username}
                  </p>
                )}
              </div>
            </div>

            <p
              className="text-sm mt-4 leading-relaxed"
              style={{ color: 'var(--muted-foreground)' }}
            >
              This Bridge is carried by {bridger.name}. Your interaction
              here can move from Bridge AI into the wider Weave.
            </p>
          </div>
        </div>
      )}

      {/* SYSTEM SWITCH — presentation before purchase, entrance after File Number */}
      <div className="max-w-2xl mx-auto w-full px-4 pt-4">
        <div
          className="rounded-2xl border p-5"
          style={{
            background: 'var(--field-surface)',
            borderColor: 'var(--field-border)',
          }}
        >
          <p
            className="text-xs uppercase tracking-wider"
            style={{ color: 'var(--secondary)' }}
          >
            Weave
          </p>

          <p
            className="text-xl font-semibold mt-1"
            style={{ color: 'var(--foreground)' }}
          >
            System Switch
          </p>

          <p
            className="text-sm mt-2"
            style={{ color: 'var(--muted-foreground)' }}
          >
            Interaction in Motion.
          </p>

          <p
            className="text-sm mt-3 leading-relaxed"
            style={{ color: 'var(--muted-foreground)' }}
          >
            System Switch is the crossing into Weave. Begin with your
            File Folder. Once your File Number is issued, the System
            Switch opens.
          </p>

          {!fileNumber && (
            <div
              className="mt-4 inline-flex px-3 py-2 rounded-lg text-xs"
              style={{
                background: 'var(--card)',
                color: 'var(--muted-foreground)',
              }}
            >
              File Folder required for entry
            </div>
          )}
        </div>
      </div>

      {supportOpen && ( 
        <div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/60 px-0 sm:px-4">
          <div className="w-full sm:max-w-md rounded-t-2xl sm:rounded-2xl border max-h-[85vh] flex flex-col" style={{ background: 'var(--card)', borderColor: 'var(--border)' }}>
            <div className="flex items-center justify-between p-4 border-b" style={{ borderColor: 'var(--field-border)' }}>
              <p className="text-sm font-semibold" style={{ color: 'var(--foreground)' }}>Talk to a specialist</p>
              <button onClick={() => { setSupportOpen(false); setSupportPosition(null) }}>
                <X className="h-4 w-4" style={{ color: 'var(--muted-foreground)' }} />
              </button>
            </div>

            {!supportPosition ? (
              <div className="p-4 space-y-2">
                <p className="text-xs mb-2" style={{ color: 'var(--muted-foreground)' }}>
                  Real people, not the AI. Choose who you'd like to reach.
                </p>
                {SUPPORT_POSITIONS.map((pos) => (
                  <button
                    key={pos.id}
                    onClick={() => handleOpenSupport(pos.id)}
                    className="w-full flex items-center gap-3 p-3 rounded-xl border text-left"
                    style={{ borderColor: 'var(--field-border)', background: 'var(--field-surface)' }}
                  >
                    <pos.icon className="h-4 w-4" style={{ color: 'var(--secondary)' }} />
                    <span className="text-sm" style={{ color: 'var(--foreground)' }}>{pos.name}</span>
                  </button>
                ))}
              </div>
            ) : (
              <>
                <div className="flex-1 overflow-y-auto p-4 space-y-3">
                  {supportLoading ? (
                    <div className="flex justify-center py-6">
                      <Loader2 className="h-5 w-5 animate-spin" style={{ color: 'var(--secondary)' }} />
                    </div>
                  ) : supportMessages.length === 0 ? (
                    <p className="text-xs text-center py-6" style={{ color: 'var(--muted-foreground)' }}>
                      Send a message and a real person will reply here.
                    </p>
                  ) : (
                    supportMessages.map((m) => (
                      <div key={m.id} className={`flex ${m.senderType === 'visitor' ? 'justify-end' : 'justify-start'}`}>
                        <div
                          className="max-w-[80%] px-3 py-2 rounded-xl text-sm"
                          style={
                            m.senderType === 'visitor'
                              ? { background: 'var(--secondary)', color: 'var(--secondary-foreground)' }
                              : { background: 'var(--field-surface)', color: 'var(--foreground)', border: '1px solid var(--field-border)' }
                          }
                        >
                          {m.content}
                        </div>
                      </div>
                    ))
                  )}
                </div>
                <div className="p-3 border-t flex gap-2" style={{ borderColor: 'var(--field-border)' }}>
                  <input
                    value={supportInput}
                    onChange={(e) => setSupportInput(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && handleSendSupportMessage()}
                    placeholder="Type your message..."
                    className="flex-1 rounded-xl px-3 py-2 text-sm outline-none border"
                    style={{ background: 'var(--input)', borderColor: 'var(--border)', color: 'var(--foreground)' }}
                  />
                  <button
                    onClick={handleSendSupportMessage}
                    disabled={supportSending || !supportInput.trim()}
                    className="px-3 rounded-xl disabled:opacity-40"
                    style={{ background: 'var(--secondary)', color: 'var(--secondary-foreground)' }}
                  >
                    <Send className="h-4 w-4" />
                  </button>
                </div>
              </>
            )}
          </div>
        </div>
      )}

      <div className="flex-1 overflow-y-auto px-4 py-6 space-y-4 max-w-2xl mx-auto w-full">
        {messages.map((msg, i) => (
          <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
            <div
              className="max-w-[85%] px-4 py-3 rounded-2xl text-sm leading-relaxed"
              style={
                msg.role === 'user'
                  ? { background: 'var(--secondary)', color: 'var(--secondary-foreground)' }
                  : { background: 'var(--card)', color: 'var(--card-foreground)', border: '1px solid var(--border)' }
              }
            >
              {msg.content}
            </div>
          </div>
        ))}
        {sending && (
          <div className="flex justify-start">
            <div className="px-4 py-3 rounded-2xl border" style={{ background: 'var(--card)', borderColor: 'var(--border)' }}>
              <Loader2 className="h-4 w-4 animate-spin" style={{ color: 'var(--secondary)' }} />
            </div>
          </div>
        )}

        {readyToJoin && !showDeposit && !understood && (
          <div className="flex justify-center pt-2">
            <button
              onClick={handleStartJoin}
              className="px-6 py-3 rounded-xl font-semibold text-sm"
              style={{ background: 'linear-gradient(135deg, var(--primary), var(--secondary))', color: '#000' }}
            >
              Continue inside Weave
            </button>
          </div>
        )}

        {readyToJoin && !showDeposit && understood === false && sessionId && messages[messages.length - 1]?.role === 'user' && (
          <div className="rounded-2xl border p-5 space-y-4" style={{ background: 'var(--card)', borderColor: 'var(--border)' }}>
            <p className="text-sm font-semibold" style={{ color: 'var(--foreground)' }}>Before you continue — here's what this actually is</p>
            <ul className="text-sm space-y-2 list-disc pl-4" style={{ color: 'var(--muted-foreground)' }}>
              <li>You'll choose an amount of TRX to send to WEAVE's business wallet on the TRON network.</li>
              <li>TRON transactions are final — once sent, a payment cannot be reversed.</li>
              <li>After your payment is confirmed by an administrator, you're issued a File Number and onboarded as a Client.</li>
              <li>If anything here is unclear, you can talk to one of our support positions below before sending anything.</li>
            </ul>
            <button
              onClick={handleConfirmUnderstanding}
              className="w-full py-3 rounded-xl font-semibold text-sm"
              style={{ background: 'linear-gradient(135deg, var(--primary), var(--secondary))', color: '#000' }}
            >
              I understand — show me how to proceed
            </button>
          </div>
        )}

        {showDeposit && understood && depositStatus === 'idle' && (
          <div className="rounded-2xl border p-5 space-y-4" style={{ background: 'var(--card)', borderColor: 'var(--border)' }}>
            <div>
              <p className="text-sm font-semibold mb-1" style={{ color: 'var(--foreground)' }}>What weight do you wish to carry</p>
              <div className="grid grid-cols-3 gap-2">
                {[FILE_FOLDER_PRICE_TRX].map(tier => (
                  <button
                    key={tier}
                    onClick={() => setSelectedTier(tier)}
                    className="py-3 rounded-xl text-sm font-bold border transition"
                    style={
                      selectedTier === tier
                        ? { background: 'var(--secondary)', color: 'var(--secondary-foreground)', borderColor: 'var(--secondary)' }
                        : { background: 'var(--field-surface)', color: 'var(--foreground)', borderColor: 'var(--field-border)' }
                    }
                  >
                    {tier.toLocaleString()} TRX
                  </button>
                ))}
              </div>
            </div>

            {selectedTier && (
              <>
                <div className="rounded-xl p-3 border" style={{ background: 'var(--field-surface)', borderColor: 'var(--field-border)' }}>
                  <p className="text-xs mb-1" style={{ color: 'var(--muted-foreground)' }}>Send {selectedTier.toLocaleString()} TRX to</p>
                  <div className="flex items-center justify-between gap-2">
                    <p className="font-mono text-xs break-all" style={{ color: 'var(--foreground)' }}>{COMPANY_WALLET}</p>
                    <button onClick={handleCopyWallet} className="shrink-0 p-1.5 rounded-lg hover:bg-white/5">
                      {copied ? <Check className="h-4 w-4" style={{ color: 'var(--success)' }} /> : <Copy className="h-4 w-4" style={{ color: 'var(--muted-foreground)' }} />}
                    </button>
                  </div>
                </div>

                <div className="space-y-2">
                  <input
                    type="text"
                    placeholder="Your full name"
                    value={prospectName}
                    onChange={(e) => setProspectName(e.target.value)}
                    className="w-full rounded-xl px-4 py-2.5 text-sm outline-none border"
                    style={{ background: 'var(--input)', borderColor: 'var(--border)', color: 'var(--foreground)' }}
                  />
                  <input
                    type="tel"
                    placeholder="WhatsApp / phone number"
                    value={prospectPhone}
                    onChange={(e) => setProspectPhone(e.target.value)}
                    className="w-full rounded-xl px-4 py-2.5 text-sm outline-none border"
                    style={{ background: 'var(--input)', borderColor: 'var(--border)', color: 'var(--foreground)' }}
                  />
                  <input
                    type="text"
                    placeholder="Transaction hash (optional, speeds up approval)"
                    value={txHash}
                    onChange={(e) => setTxHash(e.target.value)}
                    className="w-full rounded-xl px-4 py-2.5 text-sm outline-none border"
                    style={{ background: 'var(--input)', borderColor: 'var(--border)', color: 'var(--foreground)' }}
                  />
                </div>

                <button
                  onClick={handleSubmitDeposit}
                  disabled={submittingDeposit || !prospectName.trim() || !prospectPhone.trim()}
                  className="w-full py-3 rounded-xl font-semibold text-sm disabled:opacity-40"
                  style={{ background: 'linear-gradient(135deg, var(--primary), var(--secondary))', color: '#000' }}
                >
                  {submittingDeposit ? 'Moving...' : "It has moved"}
                </button>
              </>
            )}
          </div>
        )}

        {depositStatus === 'pending' && (
          <div className="rounded-2xl border p-5 text-center space-y-2" style={{ background: 'var(--card)', borderColor: 'var(--border)' }}>
            <Loader2 className="h-6 w-6 animate-spin mx-auto" style={{ color: 'var(--secondary)' }} />
            <p className="text-sm" style={{ color: 'var(--foreground)' }}>Held in stillness</p>
            <p className="text-xs" style={{ color: 'var(--muted-foreground)' }}>This does not take long. Stay a moment.</p>
          </div>
        )}

        {depositStatus === 'approved' && fileNumber && experienceType !== 'system_switch' && (
          <div className="rounded-2xl border p-5 text-center space-y-3" style={{ background: 'var(--card)', borderColor: 'var(--border)' }}>
            <p className="text-sm font-semibold" style={{ color: 'var(--success)' }}>Received</p>
            <p className="text-xs" style={{ color: 'var(--muted-foreground)' }}>Your file number:</p>
            <p className="font-mono text-sm font-bold" style={{ color: 'var(--foreground)' }}>{fileNumber}</p>
            <button
              onClick={handleGoToRegister}
              className="w-full py-3 rounded-xl font-semibold text-sm"
              style={{ background: 'linear-gradient(135deg, var(--primary), var(--secondary))', color: '#000' }}
            >
              Continue into the Weave
            </button>
          </div>
        )}

        {depositStatus === 'approved' && fileNumber && experienceType === 'system_switch' && ssGate === 'choose' && (
          <div className="rounded-2xl border p-6 text-center space-y-5" style={{ background: 'var(--card)', borderColor: 'var(--border)' }}>
            <div>
              <p className="text-xs" style={{ color: 'var(--muted-foreground)' }}>Your file number:</p>
              <p className="font-mono text-sm font-bold" style={{ color: 'var(--foreground)' }}>{fileNumber}</p>
            </div>
            <div>
              <p className="font-semibold text-lg" style={{ color: 'var(--foreground)' }}>SYSTEM SWITCH</p>
              <p className="text-xs mt-1" style={{ color: 'var(--muted-foreground)' }}>Interaction in Motion</p>
            </div>
            <div className="flex flex-col gap-3">
              {ssExistingState && (
                <button
                  onClick={handleSystemSwitchContinue}
                  className="w-full py-3 rounded-xl font-semibold text-sm"
                  style={{ background: 'linear-gradient(135deg, var(--primary), var(--secondary))', color: '#000' }}
                >
                  Continue where you left off
                </button>
              )}
              <button
                onClick={handleSystemSwitchStartFresh}
                className="w-full py-3 rounded-xl font-semibold text-sm border"
                style={{ borderColor: 'var(--field-border)', color: 'var(--foreground)', background: 'var(--field-surface)' }}
            >
                Start System Switch
              </button>
            </div>
          </div>
        )}

        {depositStatus === 'rejected' && (
          <div className="rounded-2xl border p-5 text-center space-y-2" style={{ background: 'var(--card)', borderColor: 'var(--destructive)' }}>
            <p className="text-sm" style={{ color: 'var(--destructive)' }}>This didn't come through as expected. Reach out, and we'll find the way.</p>
          </div>
        )}

        <div ref={messagesEndRef} />
      </div>

      {!showDeposit && (
        <div className="p-4 border-t max-w-2xl mx-auto w-full" style={{ borderColor: 'var(--field-border)' }}>
          <div className="flex items-center gap-2">
            <input
              type="text"
              value={input}
              onChange={(e) => setInput(e.target.value)}
              onKeyDown={(e) => { if (e.key === 'Enter') sendMessage() }}
              placeholder="Type a message..."
              className="flex-1 rounded-xl px-4 py-3 text-sm outline-none border"
              style={{ background: 'var(--input)', borderColor: 'var(--border)', color: 'var(--foreground)' }}
            />
            <button
              onClick={sendMessage}
              disabled={sending || !input.trim()}
              className="w-11 h-11 rounded-xl flex items-center justify-center disabled:opacity-40"
              style={{ background: 'var(--secondary)' }}
            >
              <Send className="h-4 w-4" style={{ color: 'var(--secondary-foreground)' }} />
            </button>
          </div>
        </div>
      )}
      </div>
    </div>
  )
}
