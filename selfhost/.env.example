# WEAVE SELF-HOST ENVIRONMENT
# Copy this file to selfhost/.env on the server. Never commit selfhost/.env.

# Core runtime
NODE_ENV=production
WEAVE_RELEASE_SHA=selfhost
WEAVE_DOMAIN=weavingsystem.online
NEXTAUTH_URL=https://weavingsystem.online
# On the actual Oracle VM use a stable matching key in the host worker and app.
WEAVE_DEPLOYMENT_SERVER=weave-oracle
WEAVE_HOST_PROVIDER=oracle

# GitHub-to-Oracle workflow. Read-only access can be anonymous for a public repo.
# Keep these blank until an operator intentionally configures scoped GitHub access.
# The promotion token allows in-app PR merges: prefer a short-lived GitHub App
# token; never allow branch-protection bypass and never prefix NEXT_PUBLIC.
WEAVE_GITHUB_READ_TOKEN=
WEAVE_GITHUB_PROMOTION_TOKEN=

# Deployment authority and records.
# selfhost/deploy-production.sh creates WEAVE_DEPLOY_RECORD_TOKEN automatically
# on the server when it is missing. WEAVE_SOVEREIGN_ID is optional; when blank,
# WEAVE resolves the Administration user for the Sovereign Scroll record.
WEAVE_DEPLOY_RECORD_TOKEN=
# Generate separately: openssl rand -hex 32. Never expose this to the browser.
# Shared only by the deployed server and host-side independent release worker.
WEAVE_RELEASE_CONTROL_TOKEN=
WEAVE_SOVEREIGN_ID=

# Required database (keep Neon during the temporary hosting phase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Authentication / recovery encryption. Generate separate long random values.
JWT_SECRET=replace-with-a-long-random-secret
NEXTAUTH_SECRET=replace-with-a-different-long-random-secret

# WEAVE-owned persistent media. docker-compose.selfhost.yml mounts this path
# into the weave-media Docker volume, so DJ tracks, ads, avatars, video assets,
# rendered videos and new System Store packages survive container rebuilds.
WEAVE_MEDIA_ROOT=/var/lib/weave/media
WEAVE_MEDIA_PUBLIC_BASE=/api/media

# Password recovery / WEAVE Gmail transport (optional if mailbox credential is stored in DB)
PASSWORD_RECOVERY_GMAIL_USER=
PASSWORD_RECOVERY_GMAIL_APP_PASSWORD=
PASSWORD_RECOVERY_GMAIL_FROM_NAME=WEAVE Access
PASSWORD_RECOVERY_REPLY_TO=

# Optional fallback mail provider
RESEND_API_KEY=
PASSWORD_RECOVERY_EMAIL_FROM=

# AI integrations. OPENAI_API_KEY lets Bridge AI, Echo and Eight operate on
# the self-hosted server without Google Cloud runtime credentials.
OPENAI_API_KEY=

# Optional legacy Google compatibility. Leave blank for a Google-independent
# self-host runtime. These are only needed by legacy/admin Google-specific paths.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_AI_KEY=

# Optional: old approved System Store objects can fall back to a public legacy
# GCS bucket URL if they have not yet been copied into WEAVE storage.
WEAVE_SYSTEM_STORE_BUCKET=
